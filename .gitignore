# .gitignore - NUNCA SUBIR ARCHIVOS SENSIBLES

# Variables de entorno
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Database
*.db
data/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Archivos de editor
*.txt~
*.bak

# Cache
.qodo/
*.cache

# Credenciales
credentials.json
token.pickle

# Ejecutables y archivos binarios no deseados
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.apk
*.zip
*.rar
*.7z
*.tar.gz

# Videos y archivos multimedia pesados (usar YouTube en su lugar)
static/*.mp4
static/*.mov
static/*.avi
static/*.mkv
static/*.wmv
